fn approx(a: f64, b: f64, eps: f64) -> bool {
    (a - b).abs() <= eps
}

@test fn binary_reader_checksum_tags_and_decoders() {
    mut b := fb.Buf::new()
    b.push_u8(0xAB)
    b.push_i8(-5)
    b.push_u16(0x1234)
    b.push_i16(-300)
    b.push_u24(0x010203)
    b.push_u32(0xDEADBEEF)
    b.push_f2dot14(0.5)
    b.push_fixed(1.25)
    b.push_tag("wght")
    mut r := bin.Reader::new(&b.data)
    assert(r.read_u8(&b.data) == 0xAB)
    assert(r.read_i8(&b.data) == -5)
    assert(r.read_u16(&b.data) == 0x1234)
    assert(r.read_i16(&b.data) == -300)
    assert(r.read_u24(&b.data) == 0x010203)
    assert(r.read_u32(&b.data) == 0xDEADBEEF)
    assert(approx(r.read_f2dot14(&b.data), 0.5, 0.0001))
    assert(approx(r.read_fixed(&b.data), 1.25, 0.0001))
    assert(r.read_tag_string(&b.data) == "wght")
    assert(r.ok)
    assert(r.remaining() == 0)

    _ := r.read_u8(&b.data)
    assert(!r.ok)

    assert(bin.tag_to_string(bin.tag_from_str("GPOS")) == "GPOS")

    // UTF-16BE including surrogate pair U+1F600 (D83D DE00)
    u16_bytes: []u8 = [0, 65, 0xD8, 0x3D, 0xDE, 0x00]
    assert(bin.decode_utf16be(&u16_bytes, 0, 6) == "A\u{1F600}")

    // MacRoman accented byte 0x80 -> U+00C4 ('Ä')
    mr: []u8 = [65, 0x80]
    assert(bin.decode_macroman(&mr, 0, 2) == "AÄ")
}

@test fn sfnt_directory_checksum_ttc_and_errors() {
    ttf0 := fb.build_synthetic_ttf(true, true)
    mut pk1 := fb.TablePack::new()
    pk1.add_owned("head", fb.tbl_head(2048, 1))
    pk1.add_owned("maxp", fb.tbl_maxp_ttf(5))
    pk1.add_owned("hhea", fb.tbl_hhea(1600, -400, 0, 2))
    ha1: []i32 = [1000, 1200]; hl1: []i32 = [0, 100, 100, 50, 100]
    pk1.add_owned("hmtx", fb.tbl_hmtx(&ha1, &hl1))
    pk1.add_owned("name", fb.tbl_name("SecondFace", "Bold", "SecondFace-Bold", "2.0"))
    gl := fb.build_sample_glyf_loca()
    c1: []i32 = [65]; g1: []i32 = [1]
    pk1.add_owned("cmap", fb.tbl_cmap_fmt4(&c1, &g1))
    pk1.add("loca", &gl.loca_long)
    pk1.add("glyf", &gl.glyf)
    ttf1 := pk1.build_sfnt(0x00010000)

    dir0 := sfnt.TableDirectory::parse(&ttf0, 0)
    assert(dir0.ok)
    assert(dir0.kind == .TrueType)
    assert(dir0.has_table("head"))
    assert(dir0.verify_table_checksum("head"))
    assert(dir0.verify_table_checksum("cmap"))

    ttc := fb.build_ttc(&ttf0, &ttf1)
    assert(sfnt.collection_face_count(&ttc) == 2)
    f0 := font.Face::from_bytes(&ttc, 0)
    f1 := font.Face::from_bytes(&ttc, 1)
    assert(f0.ok && f1.ok)
    assert(f0.names.family() == "SkriftTest")
    assert(f1.names.family() == "SecondFace")
    assert(f1.head.units_per_em == 2048)

    bad_ttc := font.Face::from_bytes(&ttc, 2)
    assert(!bad_ttc.ok)

    // WOFF2 signature should fail cleanly with explicit diagnostic
    mut woff2_stub: []u8 = []
    for _ in 0..16 { woff2_stub.push(0) }
    woff2_stub[0] = 0x77; woff2_stub[1] = 0x4F; woff2_stub[2] = 0x46; woff2_stub[3] = 0x32
    d_w2 := sfnt.TableDirectory::parse(&woff2_stub, 0)
    assert(!d_w2.ok)

    short_bytes: []u8 = [1, 2, 3]
    d_short := sfnt.TableDirectory::parse(&short_bytes, 0)
    assert(!d_short.ok)
}

@test fn zlib_inflate_stored_fixed_and_dynamic_huffman() {
    // 1. Stored block (btype=0)
    mut raw: []u8 = []
    for i in 0..40 { raw.push(u8(65 + (i % 5))) }
    stored := fb.zlib_store(&raw)
    inf0 := sfnt.zlib_decompress(&stored, 0, stored.len, raw.len)
    assert(inf0.ok)
    assert(inf0.data.len == raw.len)
    assert(inf0.data[0] == 65 && inf0.data[39] == u8(65 + (39 % 5)))

    // 2. Fixed Huffman (btype=1) with LZ77 backreferences
    fixed := fb.zlib_compress_fixed_lz77(&raw)
    assert(fixed.len < raw.len)
    inf1 := sfnt.zlib_decompress(&fixed, 0, fixed.len, raw.len)
    assert(inf1.ok)
    assert(inf1.data.len == raw.len)
    for k in 0..raw.len { assert(inf1.data[k] == raw[k]) }

    // 3. Real zlib Dynamic Huffman (btype=2) vector generated by Python zlib.compress(level=9)
    // Original payload: 847 bytes of repeating "dunder-skrift-motif" interleaved with skewed ASCII
    dyn_comp: []u8 = [
        120, 218, 109, 83, 203, 110, 219, 48, 16, 252, 162, 0, 145, 223, 58, 142,
        229, 177, 76, 201, 94, 90, 225, 74, 150, 115, 118, 3, 4, 69, 91, 32,
        77, 255, 191, 195, 244, 88, 234, 34, 106, 73, 206, 206, 99, 245, 248, 243,
        243, 241, 237, 227, 233, 247, 247, 143, 247, 183, 207, 167, 31, 191, 62, 223,
        223, 2, 201, 35, 102, 58, 105, 100, 50, 70, 163, 53, 224, 10, 250, 202,
        235, 13, 108, 8, 30, 27, 126, 61, 143, 255, 17, 24, 160, 179, 139, 20,
        181, 141, 93, 136, 251, 151, 94, 11, 85, 38, 36, 188, 10, 55, 50, 206,
        96, 45, 120, 134, 179, 151, 16, 80, 219, 70, 7, 97, 12, 116, 95, 77,
        162, 242, 58, 34, 68, 158, 172, 55, 97, 85, 211, 0, 78, 75, 145, 60,
        117, 44, 33, 24, 71, 167, 29, 5, 148, 92, 125, 144, 185, 4, 222, 133,
        153, 68, 36, 250, 89, 69, 119, 39, 182, 4, 188, 168, 66, 187, 124, 118,
        221, 174, 95, 54, 85, 82, 43, 72, 13, 123, 209, 201, 204, 177, 137, 214,
        202, 155, 196, 181, 4, 161, 136, 112, 99, 148, 81, 86, 241, 160, 38, 64,
        75, 175, 107, 241, 168, 166, 9, 28, 154, 184, 75, 188, 34, 45, 152, 141,
        142, 135, 18, 130, 196, 223, 115, 103, 118, 129, 173, 233, 125, 187, 219, 32,
        41, 152, 47, 62, 235, 94, 127, 67, 96, 53, 110, 109, 82, 100, 213, 165,
        128, 48, 26, 207, 217, 138, 171, 227, 146, 227, 24, 215, 74, 103, 107, 11,
        110, 50, 111, 105, 138, 38, 111, 14, 124, 54, 182, 40, 170, 72, 64, 202,
        30, 41, 64, 95, 224, 30, 145, 157, 139, 73, 238, 248, 93, 144, 22, 112,
        109, 145, 39, 193, 197, 52, 148, 16, 26, 147, 233, 173, 114, 226, 42, 79,
        148, 95, 210, 46, 46, 231, 72, 27, 108, 110, 37, 42, 116, 150, 135, 46,
        167, 205, 125, 209, 7, 183, 220, 45, 54, 222, 41, 131, 83, 90, 121, 107,
        241, 139, 189, 40, 187, 114, 149, 132, 240, 47, 160, 19, 218, 161, 152, 5,
        173, 70, 234, 211, 105, 153, 59, 105, 52, 155, 142, 177, 229, 85, 38, 0,
        43, 28, 184, 15, 236, 84, 222, 246, 82, 106, 40, 249, 112, 229, 58, 12,
        7, 63, 174, 105, 230, 126, 100, 26, 56, 201, 9, 228, 137, 186, 96, 210,
        255, 176, 252, 11, 17, 177, 11, 21,
    ]
    inf2 := sfnt.zlib_decompress(&dyn_comp, 0, dyn_comp.len, 847)
    assert(inf2.ok)
    assert(inf2.data.len == 847)
    // Check motif header "dunder-skrift-motif"
    motif := "dunder-skrift-motif"
    for m in 0..motif.len {
        assert(i32(inf2.data[m]) == motif[m])
    }
    assert(inf2.data[845] == 69 && inf2.data[846] == 51) // tail "E3"
}

@test fn woff1_uncompressed_and_compressed_containers() {
    w_raw := fb.build_synthetic_woff1(false)
    f_raw := font.Face::from_bytes(&w_raw, 0)
    assert(f_raw.ok)
    assert(f_raw.dir.kind == .Woff1)
    assert(f_raw.names.family() == "SkriftWoff")
    assert(f_raw.glyph_index(65) == 1)

    w_zip := fb.build_synthetic_woff1(true)
    f_zip := font.Face::from_bytes(&w_zip, 0)
    assert(f_zip.ok)
    assert(f_zip.names.family() == "SkriftWoff")
    bm := f_zip.render_glyph(1)
    assert(bm.ok && bm.width > 0 && bm.height > 0)

    bad_face := font.Face::from_bytes(&w_zip, 1)
    assert(!bad_face.ok)
}

@test fn cmap_formats_0_4_6_12_and_14_uvs() {
    ttf := fb.build_synthetic_ttf(false, false)
    dir := sfnt.TableDirectory::parse(&ttf, 0)
    cm := cmap.CmapTable::parse(&dir)
    assert(cm.ok)
    assert(cm.format == .Format12) // Format 12 (3,10) wins priority over Format 4 (3,1)
    assert(cm.lookup(&dir.data, 65) == 1)
    assert(cm.lookup(&dir.data, 66) == 2)
    assert(cm.lookup(&dir.data, 67) == 3)
    assert(cm.lookup(&dir.data, 86) == 4)
    assert(cm.lookup(&dir.data, 0x1F600) == 6)
    assert(cm.lookup(&dir.data, 9999) == 0)
    assert(cm.lookup_rune(&dir.data, rune(65)) == 1)
    assert(cm.lookup_variation(&dir.data, 65, 0xFE01) == 9)
    assert(cm.lookup_variation(&dir.data, 65, 0xFE00) == 1) // fallback when selector absent

    // Build a Format 4-only font (mix of idDelta + idRangeOffset) and check
    mut pk4 := fb.TablePack::new()
    pk4.add_owned("cmap", fb.tbl_cmap_fmt4_mixed())
    s4_bytes := pk4.build_sfnt(0x00010000)
    d4 := sfnt.TableDirectory::parse(&s4_bytes, 0)
    c4 := cmap.CmapTable::parse(&d4)
    assert(c4.ok && c4.format == .Format4)
    assert(c4.lookup(&d4.data, 65) == 1)
    assert(c4.lookup(&d4.data, 66) == 2)
    assert(c4.lookup(&d4.data, 67) == 3) // resolved via idRangeOffset + glyphIdArray
    assert(c4.lookup(&d4.data, 68) == 4) // resolved via idRangeOffset + glyphIdArray
    assert(c4.lookup(&d4.data, 69) == 0)

    // Test Format 0 (MacRoman only) and Format 6 (trimmed array only)
    mut s0_cmap := fb.Buf::new()
    s0_cmap.push_u16(0); s0_cmap.push_u16(1)
    s0_cmap.push_u16(1); s0_cmap.push_u16(0); s0_cmap.push_u32(12)
    s0_cmap.push_u16(0); s0_cmap.push_u16(262); s0_cmap.push_u16(0)
    for cp in 0..256 { s0_cmap.push_u8(if cp == 77 { 4 } else { 0 }) }
    mut pk0 := fb.TablePack::new()
    pk0.add("cmap", &s0_cmap.data)
    b0 := pk0.build_sfnt(0x00010000)
    d0 := sfnt.TableDirectory::parse(&b0, 0)
    c0 := cmap.CmapTable::parse(&d0)
    assert(c0.ok && c0.format == .Format0)
    assert(c0.lookup(&d0.data, 77) == 4)

    mut s6_cmap := fb.Buf::new()
    s6_cmap.push_u16(0); s6_cmap.push_u16(1)
    s6_cmap.push_u16(1); s6_cmap.push_u16(0); s6_cmap.push_u32(12)
    s6_cmap.push_u16(6); s6_cmap.push_u16(14); s6_cmap.push_u16(0)
    s6_cmap.push_u16(70); s6_cmap.push_u16(2); s6_cmap.push_u16(7); s6_cmap.push_u16(8)
    mut pk6 := fb.TablePack::new()
    pk6.add("cmap", &s6_cmap.data)
    b6 := pk6.build_sfnt(0x00010000)
    d6 := sfnt.TableDirectory::parse(&b6, 0)
    c6 := cmap.CmapTable::parse(&d6)
    assert(c6.ok && c6.format == .Format6)
    assert(c6.lookup(&d6.data, 70) == 7)
    assert(c6.lookup(&d6.data, 71) == 8)
    assert(c6.lookup(&d6.data, 72) == 0)
}

@test fn glyf_simple_quad_composite_and_loca() {
    ttf := fb.build_synthetic_ttf(false, false)
    dir := sfnt.TableDirectory::parse(&ttf, 0)
    loca_long := glyf.LocaTable::parse(&dir, 5, 1)
    assert(loca_long.ok)

    // gid 0 empty
    o0 := glyf.decode_glyph(&dir, &loca_long, 0)
    assert(o0.ok && o0.segment_count() == 0)

    // gid 1 rectangle (100,0)-(500,700)
    o1 := glyf.decode_glyph(&dir, &loca_long, 1)
    assert(o1.ok && o1.contour_count() == 1)
    bb1 := o1.bounds()
    assert(bb1.valid)
    assert(approx(bb1.min_x, 100.0, 0.1) && approx(bb1.max_x, 500.0, 0.1))
    assert(approx(bb1.min_y, 0.0, 0.1) && approx(bb1.max_y, 700.0, 0.1))

    // gid 2 hollow contour with 2 contours & repeat flag
    o2 := glyf.decode_glyph(&dir, &loca_long, 2)
    assert(o2.ok && o2.contour_count() == 2)

    // gid 3 quadratic arch with consecutive off-curve points
    o3 := glyf.decode_glyph(&dir, &loca_long, 3)
    assert(o3.ok && o3.contour_count() == 1)
    mut has_quad := false
    for v in &o3.verbs { if v == .QuadTo { has_quad = true } }
    assert(has_quad)
    poly3 := o3.flatten(0.5)
    assert(poly3.xs.len > 10)

    // gid 4 composite combining gid 1 + gid 1 scaled 0.5 shifted (150, 300) -> max_y = 300 + 350 = 650, base max_y = 700
    o4 := glyf.decode_glyph(&dir, &loca_long, 4)
    assert(o4.ok && o4.contour_count() == 2)
    bb4 := o4.bounds()
    assert(approx(bb4.max_y, 700.0, 0.1))

    // Verify short loca format (format = 0)
    gl := fb.build_sample_glyf_loca()
    mut pks := fb.TablePack::new()
    pks.add("loca", &gl.loca_short)
    pks.add("glyf", &gl.glyf)
    bs := pks.build_sfnt(0x00010000)
    ds := sfnt.TableDirectory::parse(&bs, 0)
    ls := glyf.LocaTable::parse(&ds, 5, 0)
    assert(ls.ok)
    os1 := glyf.decode_glyph(&ds, &ls, 1)
    assert(os1.ok && os1.contour_count() == 1)
}

@test fn rasterizer_coverage_winding_rgba_and_ascii() {
    ttf := fb.build_synthetic_ttf(false, false)
    f := font.Face::from_bytes(&ttf, 0)
    assert(f.ok)
    // Solid rectangle (gid 1): (100..500, 0..700) at 50px/1000UPEM -> width ~20px, height ~35px
    mut mf := f
    mf.set_pixel_size(50.0)
    bm_solid := mf.render_glyph(1)
    assert(bm_solid.ok && bm_solid.width >= 20 && bm_solid.height >= 35)
    // Center pixel must be solidly opaque (255)
    assert(bm_solid.pixel_at(bm_solid.width / 2, bm_solid.height / 2) == 255)
    rgba := bm_solid.to_rgba(10, 20, 30)
    assert(rgba.len == bm_solid.width * bm_solid.height * 4)
    assert(rgba[3] == bm_solid.pixels[0])

    // Hollow counter rectangle (gid 2): center pixel lies inside opposite-wound hole -> 0 coverage!
    bm_hollow := mf.render_glyph(2)
    assert(bm_hollow.ok && bm_hollow.width >= 25 && bm_hollow.height >= 30)
    assert(bm_hollow.pixel_at(bm_hollow.width / 2, bm_hollow.height / 2) == 0)
    // Border stroke on left wall must still be filled (> 200)
    assert(bm_hollow.pixel_at(2, bm_hollow.height / 2) > 200)
    art := bm_hollow.ascii_art()
    assert(art.len > 0)

    // Empty outline produces empty bitmap cleanly
    bm_empty := mf.render_glyph(0)
    assert(bm_empty.ok && bm_empty.width == 0 && bm_empty.height == 0)
}

@test fn kern_and_gpos_pairpos_formats() {
    ttf := fb.build_synthetic_ttf(false, false)
    mut f := font.Face::from_bytes(&ttf, 0)
    assert(f.ok)
    assert(f.metrics().has_kerning)

    // Pair (1, 2): GPOS Format 1 (-85) takes priority over legacy kern (-50)
    assert(f.kern_units(1, 2) == -85)
    assert(f.kern_units(1, 3) == -40)
    // Pair (4, 1): GPOS Format 2 ClassDef (-120)
    assert(f.kern_units(4, 1) == -120)
    // Pair (5, 1): GPOS LookupType 9 Extension wrapping Format 1 (+55)
    assert(f.kern_units(5, 1) == 55)
    // Pair (2, 3): Only in legacy kern Format 0 (-25)
    assert(f.kern_units(2, 3) == -25)
    // Unkerned pair
    assert(f.kern_units(1, 1) == 0)

    // Verify render_text uses kerning in advance_x calculation
    f.set_pixel_size(20.0) // scale = 0.02
    rt_no_kern := f.render_text("AA") // 600 + 600 = 1200 units -> 24.0px
    rt_kern := f.render_text("AB")    // 600 - 85 + 600 = 1115 units -> 22.3px
    assert(rt_no_kern.ok && rt_kern.ok)
    assert(approx(rt_no_kern.advance_x, 24.0, 0.01))
    assert(approx(rt_kern.advance_x, 22.3, 0.01))
}

@test fn variable_fonts_fvar_avar_hvar_and_gvar() {
    ttf := fb.build_synthetic_ttf(true, false)
    mut f := font.Face::from_bytes(&ttf, 0)
    assert(f.ok)
    assert(f.metrics().is_variable)
    assert(f.fvar_table.axis_count == 1)
    ax := f.fvar_table.axis_at(0)
    assert(ax.tag == "wght" && ax.default_value == 400.0 && ax.max_value == 900.0)

    // Default wght=400 -> norm=0.0
    assert(approx(f.glyph_advance_units(1), 600.0, 0.01))
    bb_def := f.glyph_outline_units(1).bounds()
    assert(approx(bb_def.max_x, 500.0, 0.1) && approx(bb_def.max_y, 700.0, 0.1))

    // Non-linear avar test: wght=650 -> linear norm=(650-400)/(900-400)=0.5 -> avar maps 0.5 -> 0.25!
    // HVAR advance delta at peak 1.0 is +120, so at avar=0.25 -> +30.0 (630.0 units)
    assert(f.set_axis("wght", 650.0))
    assert(approx(f.norm_coords[0], 0.25, 0.001))
    assert(approx(f.glyph_advance_units(1), 630.0, 0.5))

    // Max weight wght=900 -> norm=1.0:
    // HVAR advance = 600 + 120 = 720
    // gvar point 2 delta = (+80, +100) -> max_x=580, max_y=800
    assert(f.set_axis("wght", 900.0))
    assert(approx(f.glyph_advance_units(1), 720.0, 0.01))
    bb_bold := f.glyph_outline_units(1).bounds()
    assert(approx(bb_bold.max_x, 580.0, 0.1))
    assert(approx(bb_bold.max_y, 800.0, 0.1))

    f.reset_axes()
    assert(approx(f.glyph_advance_units(1), 600.0, 0.01))
}

@test fn cpal_palettes_and_colr_v0_layers() {
    ttf := fb.build_synthetic_ttf(false, true)
    f := font.Face::from_bytes(&ttf, 0)
    assert(f.ok && f.metrics().has_color)

    l0 := f.color_layers(1, 0)
    assert(l0.layer_gids.len == 3)
    assert(l0.layer_gids[0] == 2 && l0.layer_gids[1] == 3 && l0.layer_gids[2] == 4)
    // Layer 0 palette 0 entry 0: Red (255, 0, 0, 255)
    assert(l0.rgba[0] == 255 && l0.rgba[1] == 0 && l0.rgba[2] == 0 && l0.rgba[3] == 255)
    // Layer 1 palette 0 entry 1: Blue (0, 128, 255, 255)
    assert(l0.rgba[4] == 0 && l0.rgba[5] == 128 && l0.rgba[6] == 255 && l0.rgba[7] == 255)
    // Layer 2 palette 0xFFFF -> foreground fallback white (255, 255, 255, 255)
    assert(l0.rgba[8] == 255 && l0.rgba[9] == 255 && l0.rgba[10] == 255 && l0.rgba[11] == 255)

    // Switch to palette 1 -> Green (0, 255, 0, 255) + White semi (255, 255, 255, 128)
    l1 := f.color_layers(1, 1)
    assert(l1.rgba[0] == 0 && l1.rgba[1] == 255 && l1.rgba[2] == 0 && l1.rgba[3] == 255)
    assert(l1.rgba[4] == 255 && l1.rgba[5] == 255 && l1.rgba[6] == 255 && l1.rgba[7] == 128)

    empty_layers := f.color_layers(99, 0)
    assert(empty_layers.layer_gids.len == 0)
}

@test fn cff_v1_subrs_cubic_and_width() {
    otf := fb.build_synthetic_otf_cff()
    mut f := font.Face::from_bytes(&otf, 0)
    assert(f.ok)
    assert(f.metrics().is_cff && !f.metrics().is_cff2)

    // gid 1 uses rmoveto(50,0) with width operand 100, then global+local subroutines for 500x600 rect!
    o1 := f.glyph_outline_units(1)
    assert(o1.ok)
    bb1 := o1.bounds()
    assert(bb1.valid)
    assert(approx(bb1.min_x, 50.0, 0.1) && approx(bb1.max_x, 550.0, 0.1))
    assert(approx(bb1.min_y, 0.0, 0.1) && approx(bb1.max_y, 600.0, 0.1))

    // gid 2 contains a cubic Bezier curve (`rrcurveto`)
    o2 := f.glyph_outline_units(2)
    assert(o2.ok)
    mut has_cubic := false
    for v in &o2.verbs { if v == .CubicTo { has_cubic = true } }
    assert(has_cubic)
    poly2 := o2.flatten(0.5)
    assert(poly2.xs.len > 10)

    f.set_pixel_size(25.0)
    bm := f.render_rune(rune(65))
    assert(bm.ok && bm.width >= 12 && bm.height >= 14)
    assert(bm.pixel_at(bm.width / 2, bm.height / 2) == 255)
}

@test fn cff2_ivs_blend_operator() {
    cff2 := fb.build_synthetic_otf_cff2()
    mut f := font.Face::from_bytes(&cff2, 0)
    assert(f.ok)
    assert(f.metrics().is_cff2 && f.metrics().is_variable)

    // At default wght=400 (scalar=0): box is x=100..400, y=0..600
    bb0 := f.glyph_outline_units(1).bounds()
    assert(bb0.valid)
    assert(approx(bb0.min_x, 100.0, 0.1) && approx(bb0.max_x, 400.0, 0.1))

    // At wght=900 (scalar=1): blend adds +200 -> box expands to x=100..600!
    assert(f.set_axis("wght", 900.0))
    bb1 := f.glyph_outline_units(1).bounds()
    assert(approx(bb1.min_x, 100.0, 0.1) && approx(bb1.max_x, 600.0, 0.1))
}

@test fn real_macos_system_fonts_when_present() {
    arial := "/System/Library/Fonts/Supplemental/Arial.ttf"
    if sys.metadata(arial).is_file {
        mut f := font.Face::from_file(arial, 0)
        assert(f.ok && f.glyph_index(65) > 0)
        assert(f.kern_units(f.glyph_index(65), f.glyph_index(86)) < 0)
        f.set_pixel_size(24.0)
        bm := f.render_rune(rune(65))
        assert(bm.ok && bm.width > 10 && bm.height > 10)
    }
    stix := "/System/Library/Fonts/Supplemental/STIXGeneral.otf"
    if sys.metadata(stix).is_file {
        f := font.Face::from_file(stix, 0)
        assert(f.ok && f.metrics().is_cff && f.metrics().has_kerning)
    }
    ny := "/System/Library/Fonts/NewYork.ttf"
    if sys.metadata(ny).is_file {
        mut f := font.Face::from_file(ny, 0)
        assert(f.ok && f.metrics().is_variable)
        adv_reg := f.glyph_advance_units(f.glyph_index(103))
        _ := f.set_axis("wght", 900.0)
        adv_bld := f.glyph_advance_units(f.glyph_index(103))
        assert(adv_bld > adv_reg)
    }
}

@test fn cff_cid_fdselect3_and_gpos_fmt2_cov2_cls2() {
    cid := fb.build_synthetic_otf_cid_fdselect3()
    f := font.Face::from_bytes(&cid, 0)
    assert(f.ok && f.metrics().is_cff)

    // gid 1 uses FD 0 (hmoveto with width arg -> starts at x=50, local subr 0 goes y=400, hvcurveto ends x=350)
    bb1 := f.glyph_outline_units(1).bounds()
    assert(bb1.valid)
    assert(approx(bb1.min_x, 50.0, 0.1) && approx(bb1.max_x, 350.0, 0.1))
    assert(approx(bb1.max_y, 500.0, 0.1))

    // gid 2 uses FD 1 local subr 0 (y=700 vs FD 0's 400!)
    bb2 := f.glyph_outline_units(2).bounds()
    assert(bb2.valid)
    assert(approx(bb2.min_x, 100.0, 0.1) && approx(bb2.max_y, 700.0, 0.1))

    // GPOS Coverage Format 2 + ClassDef Format 2 + ValueRecord2 stride
    gp_bytes := fb.build_gpos_fmt2_cov2_cls2()
    gp_dir := sfnt.TableDirectory::parse(&gp_bytes, 0)
    kt := gpos.KernTable::parse(&gp_dir)
    assert(kt.has_kerning())
    assert(kt.kern_x(&gp_dir.data, 2, 4) == -95)
    assert(kt.kern_x(&gp_dir.data, 3, 5) == -95)
    assert(kt.kern_x(&gp_dir.data, 2, 2) == 0)
}
