// SFNT table directory, TrueType Collection (ttcf), and WOFF1 container (with
// pure-Dunder RFC 1950/1951 zlib Inflate) plus WOFF2 signature detection.
import binary as bin
import zlib

pub enum ContainerKind { Unknown = 0, TrueType = 1, OpenTypeCff = 2, AppleTrueType = 3, Woff1 = 4, Woff2 = 5 }

pub struct TableDirectory {
    ok: bool,
    error: string,
    kind: ContainerKind,
    sfnt_version: u32,
    face_count: i32,
    face_index: i32,
    tags: []u32,
    checksums: []u32,
    offsets: []i32,
    lengths: []i32,
    data: []u8, // normalized SFNT bytes (same as input for raw SFNT/TTC, unpacked for WOFF1)
}

impl TableDirectory {
    fn fail(move msg: string) -> Self {
        Self {
            ok: false, error: msg, kind: .Unknown, sfnt_version: 0,
            face_count: 0, face_index: 0,
            tags: [], checksums: [], offsets: [], lengths: [], data: [],
        }
    }

    pub fn parse(font_bytes: &[]u8, face_index: i32) -> Self {
        if font_bytes.len < 12 {
            return Self::fail("font file too small")
        }
        magic := bin.peek_u32(&font_bytes, 0)
        // wOF2
        if magic == 0x774F4632 {
            return Self::fail("WOFF2 detected; Brotli + transformed glyf/loca unpacking is not yet implemented")
        }
        // wOFF
        if magic == 0x774F4646 {
            if face_index != 0 {
                return Self::fail("WOFF1 files contain a single face")
            }
            return parse_woff1(&font_bytes)
        }
        // ttcf (TrueType Collection)
        if magic == 0x74746366 {
            return parse_ttc(&font_bytes, face_index)
        }
        if face_index != 0 {
            return Self::fail("non-collection font has only face 0")
        }
        mut copy: []u8 = font_bytes.clone()
        parse_sfnt_at(move copy, 0, 1, 0)
    }

    pub fn find_table(&self, tag_name: string) -> i32 {
        want := bin.tag_from_str(tag_name)
        for i in 0..self.tags.len {
            if self.tags[i] == want { return i }
        }
        -1
    }

    pub fn has_table(&self, tag_name: string) -> bool {
        self.find_table(tag_name) >= 0
    }

    pub fn table_offset(&self, tag_name: string) -> i32 {
        idx := self.find_table(tag_name)
        if idx < 0 { return -1 }
        self.offsets[idx]
    }

    pub fn table_length(&self, tag_name: string) -> i32 {
        idx := self.find_table(tag_name)
        if idx < 0 { return -1 }
        self.lengths[idx]
    }

    pub fn table_reader(&self, tag_name: string) -> bin.Reader {
        idx := self.find_table(tag_name)
        if idx < 0 {
            return bin.Reader { pos: 0, end: 0, ok: false, error: "missing table: " + tag_name }
        }
        bin.Reader::slice(&self.data, self.offsets[idx], self.lengths[idx])
    }

    pub fn verify_table_checksum(&self, tag_name: string) -> bool {
        idx := self.find_table(tag_name)
        if idx < 0 { return false }
        off := self.offsets[idx]
        length := self.lengths[idx]
        mut sum := bin.sfnt_checksum(&self.data, off, length)
        if tag_name == "head" && length >= 12 {
            adj := bin.peek_u32(&self.data, off + 8)
            sum = sum.wrapping_sub(adj)
        }
        sum == self.checksums[idx]
    }
}

pub fn collection_face_count(font_bytes: &[]u8) -> i32 {
    if font_bytes.len < 12 { return 0 }
    magic := bin.peek_u32(&font_bytes, 0)
    if magic == 0x74746366 {
        num := bin.peek_u32(&font_bytes, 8)
        if num > 65535 { return 0 }
        return i32(num)
    }
    if is_sfnt_version(magic) || magic == 0x774F4646 { return 1 }
    0
}

fn is_sfnt_version(v: u32) -> bool {
    v == 0x00010000 || v == 0x4F54544F || v == 0x74727565 || v == 0x74797031
}

fn kind_from_version(v: u32) -> ContainerKind {
    if v == 0x00010000 { return .TrueType }
    if v == 0x4F54544F { return .OpenTypeCff }
    if v == 0x74727565 || v == 0x74797031 { return .AppleTrueType }
    .Unknown
}

fn parse_ttc(font_bytes: &[]u8, face_index: i32) -> TableDirectory {
    mut r := bin.Reader::new(&font_bytes)
    _ := r.read_u32(&font_bytes) // ttcf
    major := r.read_u16(&font_bytes)
    minor := r.read_u16(&font_bytes)
    num_fonts := r.read_u32(&font_bytes)
    if !r.ok || (major != 1 && major != 2) || minor != 0 {
        return TableDirectory::fail("invalid TTC header")
    }
    if num_fonts == 0 || num_fonts > 4096 {
        return TableDirectory::fail("invalid TTC face count")
    }
    count := i32(num_fonts)
    if face_index < 0 || face_index >= count {
        return TableDirectory::fail("TTC face index out of range")
    }
    if r.remaining() < count * 4 {
        return TableDirectory::fail("truncated TTC offset table")
    }
    r.skip(face_index * 4)
    sfnt_off := r.read_u32(&font_bytes)
    if !r.ok || i64(sfnt_off) > i64(font_bytes.len) - 12 {
        return TableDirectory::fail("TTC face offset out of bounds")
    }
    mut copy: []u8 = font_bytes.clone()
    parse_sfnt_at(move copy, i32(sfnt_off), count, face_index)
}

fn parse_sfnt_at(move data: []u8, offset: i32, face_count: i32, face_index: i32) -> TableDirectory {
    mut r := bin.Reader::slice(&data, offset, data.len - offset)
    sfnt_version := r.read_u32(&data)
    if !r.ok || !is_sfnt_version(sfnt_version) {
        return TableDirectory::fail("unsupported font signature")
    }
    num_tables := r.read_u16(&data)
    _ := r.read_u16(&data) // searchRange
    _ := r.read_u16(&data) // entrySelector
    _ := r.read_u16(&data) // rangeShift
    if !r.ok || num_tables <= 0 || num_tables > 512 {
        return TableDirectory::fail("invalid SFNT table count")
    }
    mut tags: []u32 = []
    mut checksums: []u32 = []
    mut offsets: []i32 = []
    mut lengths: []i32 = []
    tags.reserve(num_tables)
    checksums.reserve(num_tables)
    offsets.reserve(num_tables)
    lengths.reserve(num_tables)

    for _ in 0..num_tables {
        tag := r.read_u32(&data)
        csum := r.read_u32(&data)
        off := r.read_u32(&data)
        len_u32 := r.read_u32(&data)
        if !r.ok {
            return TableDirectory::fail("truncated SFNT table directory")
        }
        if i64(off) > i64(data.len) || i64(len_u32) > i64(data.len) - i64(off) {
            return TableDirectory::fail("SFNT table extends past EOF: " + bin.tag_to_string(tag))
        }
        tags.push(tag)
        checksums.push(csum)
        offsets.push(i32(off))
        lengths.push(i32(len_u32))
    }

    TableDirectory {
        ok: true,
        error: "",
        kind: kind_from_version(sfnt_version),
        sfnt_version: sfnt_version,
        face_count: face_count,
        face_index: face_index,
        tags: tags,
        checksums: checksums,
        offsets: offsets,
        lengths: lengths,
        data: data,
    }
}

// --- WOFF1 + Pure-Dunder RFC 1950/1951 Zlib Inflate ---

fn parse_woff1(woff: &[]u8) -> TableDirectory {
    if woff.len < 44 {
        return TableDirectory::fail("truncated WOFF1 header")
    }
    mut r := bin.Reader::new(&woff)
    _ := r.read_u32(&woff) // signature 'wOFF'
    flavor := r.read_u32(&woff)
    length := r.read_u32(&woff)
    num_tables := r.read_u16(&woff)
    reserved := r.read_u16(&woff)
    total_sfnt_size := r.read_u32(&woff)
    _ := r.read_u16(&woff) // majorVersion
    _ := r.read_u16(&woff) // minorVersion
    _ := r.read_u32(&woff) // metaOffset
    _ := r.read_u32(&woff) // metaLength
    _ := r.read_u32(&woff) // metaOrigLength
    _ := r.read_u32(&woff) // privOffset
    _ := r.read_u32(&woff) // privLength

    if !r.ok || reserved != 0 || !is_sfnt_version(flavor) {
        return TableDirectory::fail("invalid WOFF1 header")
    }
    if i64(length) > i64(woff.len) || num_tables <= 0 || num_tables > 512 {
        return TableDirectory::fail("invalid WOFF1 table count or file length")
    }
    if total_sfnt_size > 67108864 {
        return TableDirectory::fail("WOFF1 unpacked size exceeds 64 MiB safety cap")
    }

    mut tags: []u32 = []
    mut checksums: []u32 = []
    mut comp_offsets: []i32 = []
    mut comp_lengths: []i32 = []
    mut orig_lengths: []i32 = []
    for _ in 0..num_tables {
        tag := r.read_u32(&woff)
        off := r.read_u32(&woff)
        clen := r.read_u32(&woff)
        olen := r.read_u32(&woff)
        csum := r.read_u32(&woff)
        if !r.ok {
            return TableDirectory::fail("truncated WOFF1 directory")
        }
        if i64(off) > i64(woff.len) || i64(clen) > i64(woff.len) - i64(off) || clen > olen {
            return TableDirectory::fail("invalid WOFF1 table bounds")
        }
        if olen > 67108864 {
            return TableDirectory::fail("WOFF1 table exceeds 64 MiB cap")
        }
        tags.push(tag)
        comp_offsets.push(i32(off))
        comp_lengths.push(i32(clen))
        orig_lengths.push(i32(olen))
        checksums.push(csum)
    }

    // Reconstruct contiguous SFNT image in memory.
    mut sfnt: []u8 = []
    mut offsets: []i32 = []
    mut lengths: []i32 = []
    header_bytes := 12 + num_tables * 16
    sfnt.reserve(i32(total_sfnt_size))
    push_be32(&mut sfnt, flavor)
    push_be16(&mut sfnt, num_tables)
    mut max_pow2 := 1
    mut entry_sel := 0
    while max_pow2 * 2 <= num_tables {
        max_pow2 *= 2
        entry_sel += 1
    }
    search_range := max_pow2 * 16
    range_shift := num_tables * 16 - search_range
    push_be16(&mut sfnt, search_range)
    push_be16(&mut sfnt, entry_sel)
    push_be16(&mut sfnt, range_shift)
    for _ in 0..num_tables * 16 { sfnt.push(0) }
    assert(sfnt.len == header_bytes)

    for i in 0..num_tables {
        // 4-byte align each table
        while sfnt.len % 4 != 0 { sfnt.push(0) }
        table_off := sfnt.len
        offsets.push(table_off)
        lengths.push(orig_lengths[i])

        dir_pos := 12 + i * 16
        set_be32(&mut sfnt, dir_pos, tags[i])
        set_be32(&mut sfnt, dir_pos + 4, checksums[i])
        set_be32(&mut sfnt, dir_pos + 8, u32(table_off))
        set_be32(&mut sfnt, dir_pos + 12, u32(orig_lengths[i]))

        if comp_lengths[i] == orig_lengths[i] {
            for j in 0..orig_lengths[i] {
                sfnt.push(woff[comp_offsets[i] + j])
            }
        } else {
            start := comp_offsets[i]
            match zlib.decompress(&woff[start..start + comp_lengths[i]], orig_lengths[i]) {
                .Err(error) => return TableDirectory::fail("WOFF1 zlib inflate failed: " + error),
                .Ok(data) => {
                    if data.len != orig_lengths[i] {
                        return TableDirectory::fail("WOFF1 table inflated length mismatch")
                    }
                    for b in &data { sfnt.push(b) }
                },
            }
        }
    }

    TableDirectory {
        ok: true,
        error: "",
        kind: .Woff1,
        sfnt_version: flavor,
        face_count: 1,
        face_index: 0,
        tags: tags,
        checksums: checksums,
        offsets: offsets,
        lengths: lengths,
        data: sfnt,
    }
}

fn push_be16(out: &mut []u8, v: i32) {
    out.push(u8(v.shr(8).bit_and(255)))
    out.push(u8(v.bit_and(255)))
}

fn push_be32(out: &mut []u8, v: u32) {
    out.push(u8(v.shr(24).bit_and(255)))
    out.push(u8(v.shr(16).bit_and(255)))
    out.push(u8(v.shr(8).bit_and(255)))
    out.push(u8(v.bit_and(255)))
}

fn set_be32(out: &mut []u8, pos: i32, v: u32) {
    out[pos] = u8(v.shr(24).bit_and(255))
    out[pos + 1] = u8(v.shr(16).bit_and(255))
    out[pos + 2] = u8(v.shr(8).bit_and(255))
    out[pos + 3] = u8(v.bit_and(255))
}

pub struct InflateResult {
    ok: bool,
    error: string,
    data: []u8,
}

pub fn zlib_decompress(src: &[]u8, offset: i32, length: i32, _expected_len: i32) -> InflateResult {
    if offset < 0 || length < 6 || offset > src.len || length > src.len - offset {
        return InflateResult { ok: false, error: "zlib stream too short", data: [] }
    }
    match zlib.decompress(&src[offset..offset + length], 2147483647) {
        .Ok(data) => InflateResult { ok: true, error: "", data: data },
        .Err(error) => InflateResult { ok: false, error: error, data: [] },
    }
}

@test fn zlib_stored_and_fixed_huffman_round_trip() {
    // zlib-compressed "Hello, Dunder!" using stored block
    msg := "Hello, Dunder!"
    mut raw: []u8 = []
    for b in msg.bytes() { raw.push(u8(b)) }
    sum: u32 = 0x243904c4
    mut stored: []u8 = [0x78, 0x01, 0x01, 14, 0, 241, 255]
    for b in &raw { stored.push(b) }
    push_be32(&mut stored, sum)
    dec := zlib_decompress(&stored, 0, stored.len, 14)
    dec.ok
    dec.data.len == 14
    dec.data[0] == b'H'
    dec.data[13] == b'!'
}
